    font-weight: bold;

    margin-bottom: 2px;
}

.radar {

    text-align: center;

    margin-top: 5px;
}

.footer {

    position: absolute;

    bottom: 5mm;

    left: 8mm;

    right: 8mm;

    text-align: center;

    font-size: 8px;

    color: #777;
}

@@media print {

    @@page {

        size: A4;

        margin: 0;
    }

    body {

        background: white;
    }

    .page {

        margin: 0;

        width: 210mm;

        min-height: 297mm;

        box-shadow: none;
    }

}

</style>

</head>

<body>


<!-- =======================================================
     صفحه اول
     ======================================================= -->

<div class="page">

    <div class="report-title">
        کارنامه ارزیابی عملکرد کارکنان
    </div>


    <table class="info-table">

        <tr>

            <td class="info-label">
                ارزیابی‌شونده
            </td>

            <td class="info-value">
                ${escapeHtml(employeeName)}
            </td>

            <td class="info-label">
                شماره پرسنلی
            </td>

            <td class="info-value">
                ${escapeHtml(employeeCode)}
            </td>

            <td class="info-label">
                دوره ارزیابی
            </td>

            <td class="info-value">
                ${evaluationPeriod}
            </td>

        </tr>


        <tr>

            <td class="info-label">
                عنوان پست سازمانی
            </td>

            <td class="info-value">
                ${escapeHtml(jobTitle)}
            </td>

            <td class="info-label">
                واحد سازمانی
            </td>

            <td class="info-value">
                -
            </td>

            <td class="info-label">
                ارزیاب
            </td>

            <td class="info-value">
                ${escapeHtml(evaluatorName)}
            </td>

        </tr>

    </table>


    <table class="score-table">

        <tr>

            <th>
                امتیاز ارزیابی نتایج
            </th>

            <th>
                امتیاز ارزیابی شایستگی
            </th>

            <th>
                امتیاز نهایی عملکرد
            </th>

            <th>
                وضعیت نهایی عملکرد
            </th>

        </tr>

        <tr>

            <td class="score-number">
                ${resultScore}
            </td>

            <td class="score-number">
                ${competencyScore}
            </td>

            <td class="score-number">
                ${finalScore}
            </td>

            <td class="grade">
                ${grade}
            </td>

        </tr>

    </table>


    <div class="section-title">
        ارزیابی نتایج
    </div>


    <table class="result-table">

        <thead>

            <tr>

                <th style="width:7%">
                    ردیف
                </th>

                <th>
                    مهم‌ترین اقدامات، فعالیت‌ها و پروژه‌ها
                </th>

                <th style="width:12%">
                    ضریب اهمیت
                </th>

                <th style="width:16%">
                    وضعیت انجام
                </th>

            </tr>

        </thead>

        <tbody>

            ${resultsHtml}

        </tbody>

    </table>


    <div class="section-title">
        ارزیابی شایستگی‌ها
    </div>

    ${createCompetencyHtml(firstPageCompetencies)}


    <div class="footer">
        کارنامه ارزیابی عملکرد - ${escapeHtml(employeeName)}
    </div>

</div>


<!-- =======================================================
     صفحه دوم
     ======================================================= -->

<div class="page">

    <div class="report-title">
        کارنامه ارزیابی عملکرد
    </div>


    <div class="section-title">
        ادامه ارزیابی شایستگی‌ها
    </div>


    ${createCompetencyHtml(secondPageCompetencies)}


    <div class="summary-grid">

        <div class="summary-box">

            <div class="summary-header">
                مهم‌ترین مصادیق رفتاری مثبت
            </div>

            ${createBulletList(positiveBehaviors)}

        </div>


        <div class="summary-box">

            <div class="summary-header">
                مهم‌ترین مصادیق رفتاری قابل بهبود
            </div>

            ${createBulletList(improvementBehaviors)}

        </div>


        <div class="summary-box">

            <div class="radar-title">
                وضعیت ارزیابی شایستگی
            </div>

            <div class="radar">

                ${createRadarChart(radarItems)}

            </div>

        </div>

    </div>


    <div class="improvement-box">

        <div class="improvement-label">

            مهم‌ترین پیشنهادات جهت بهبود

        </div>

        <div class="improvement-text">

            ${escapeHtml(
                document
                    .getElementById(
                        "improvementText"
                    )
                    .value
                    .trim()
            )}

        </div>

    </div>


    <div class="footer">
        کارنامه ارزیابی عملکرد - ${escapeHtml(employeeName)}
    </div>

</div>


</body>

</html>

`);


        reportWindow.document.close();
    }


    /* =========================================================
       توابع کمکی کارنامه
       ========================================================= */

    function escapeHtml(value) {

        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }


    function shortenText(text, maxLength) {

        if (text.length <= maxLength) {
            return text;
        }

        return text.substring(
            0,
            maxLength
        ) + "…";
    }


    /* =========================================================
       محاسبه اولیه
       ========================================================= */

    calculateScores();

</script>