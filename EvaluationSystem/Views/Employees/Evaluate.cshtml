                 </div>`;
        }
    }


    /* =========================================================
       دریافت شرح وظایف یک شغل
       ========================================================= */

    async function loadDutiesForJob(jobId) {

        const list =
            document.getElementById(
                "dutyList"
            );


        list.innerHTML =
            `<div class="duty-loading">
                در حال بارگذاری شرح وظایف...
             </div>`;


        const response =
            await fetch(
                '@Url.Action("GetJobDuties", "Employees")?jobId='
                + encodeURIComponent(jobId)
            );


        if (!response.ok) {

            throw new Error(
                "خطا در دریافت شرح وظایف"
            );
        }


        const duties =
            await response.json();


        list.innerHTML = "";


        if (
            !duties ||
            duties.length === 0
        ) {

            list.innerHTML =
                `<div class="duty-empty">
