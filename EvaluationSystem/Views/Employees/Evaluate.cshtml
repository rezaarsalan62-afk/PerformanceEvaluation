    /* =========================================================
       باز کردن پنجره انتخاب شرح وظایف
       ========================================================= */

    async function openDutyModal(rowIndex) {

        activeResultRow =
            rowIndex;


        const modal =
            document.getElementById(
                "dutyModalBackdrop"
            );


        const categorySelect =
            document.getElementById(
                "dutyJobCategory"
            );


        const jobSelect =
            document.getElementById(
                "dutyJob"
            );


        const dutyList =
            document.getElementById(
                "dutyList"
            );


        modal.classList.add("show");


        categorySelect.innerHTML =
            `<option value="">
                در حال بارگذاری...
             </option>`;


        jobSelect.innerHTML =
            `<option value="">
                در حال بارگذاری...
             </option>`;


        dutyList.innerHTML =
            `<div class="duty-loading">
                در حال بارگذاری شرح وظایف...
             </div>`;


        try {

            /*
               دریافت رسته‌های شغلی
            */

            const categoryResponse =
                await fetch(
                    '@Url.Action("GetJobCategories", "Employees")'
                );


            if (!categoryResponse.ok) {

                throw new Error(
                    "خطا در دریافت رسته‌های شغلی"
                );
            }


            const categories =
                await categoryResponse.json();


            categorySelect.innerHTML =
                `<option value="">
                    انتخاب رسته شغلی
                 </option>`;


            categories.forEach(category => {

                const option =
                    document.createElement("option");


                option.value =
                    category.id;


                option.textContent =
                    category.title;


                categorySelect.appendChild(option);

            });


            /*
               انتخاب رسته شغل اصلی کارمند
            */

            categorySelect.value =
                String(
                    currentEmployeeJobCategoryId
                );


            /*
               دریافت مشاغل رسته
            */

            await loadJobsForCategory(
                currentEmployeeJobCategoryId
            );


            /*
               انتخاب شغل اصلی کارمند
            */

            jobSelect.value =
                String(
                    currentEmployeeJobId
                );


            /*
               دریافت وظایف شغل اصلی
            */

            await loadDutiesForJob(
                currentEmployeeJobId
            );

        }
        catch (error) {

            console.error(error);


            dutyList.innerHTML =
                `<div class="duty-empty">
                    خطا در دریافت اطلاعات شرح وظایف
                 </div>`;
        }
    }


    /* =========================================================
       تغییر رسته
       ========================================================= */

    async function loadJobsForSelectedCategory() {

        const categoryId =
            document.getElementById(
                "dutyJobCategory"
            ).value;


        const jobSelect =
            document.getElementById(
                "dutyJob"
            );


        const dutyList =
            document.getElementById(
                "dutyList"
            );


        if (!categoryId) {

            jobSelect.innerHTML =
                `<option value="">
                    ابتدا رسته را انتخاب کنید
                 </option>`;


            dutyList.innerHTML =
                `<div class="duty-empty">
                    ابتدا رسته شغلی را انتخاب کنید
                 </div>`;


            return;
        }


        try {

            await loadJobsForCategory(
                categoryId
            );


            /*
               پس از تغییر رسته،
               اولین شغل به‌صورت خودکار انتخاب می‌شود.
            */

            if (
                jobSelect.options.length > 1
            ) {

                jobSelect.selectedIndex = 1;


                await loadDutiesForJob(
                    jobSelect.value
                );

            }
            else {

                dutyList.innerHTML =
                    `<div class="duty-empty">
                        برای این رسته شغلی، شغلی ثبت نشده است.
                     </div>`;
            }

        }
        catch (error) {

            console.error(error);


            dutyList.innerHTML =
                `<div class="duty-empty">
                    خطا در دریافت مشاغل
                 </div>`;
        }
    }


    /* =========================================================
       دریافت مشاغل یک رسته
       ========================================================= */

    async function loadJobsForCategory(categoryId) {

        const jobSelect =
            document.getElementById(
                "dutyJob"
            );


        jobSelect.innerHTML =
            `<option value="">
                در حال بارگذاری...
             </option>`;


        const response =
            await fetch(
                '@Url.Action("GetJobsByCategory", "Employees")?categoryId='
                + encodeURIComponent(categoryId)
            );


        if (!response.ok) {

            throw new Error(
                "خطا در دریافت مشاغل"
            );
        }


        const jobs =
            await response.json();


        jobSelect.innerHTML =
            `<option value="">
                انتخاب عنوان شغلی
             </option>`;


        jobs.forEach(job => {

            const option =
                document.createElement("option");


            option.value =
                job.id;


            option.textContent =
                job.title;


            jobSelect.appendChild(option);

        });
    }


