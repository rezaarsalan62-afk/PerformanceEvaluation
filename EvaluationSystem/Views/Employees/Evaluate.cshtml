    /* =========================================================
       محاسبه امتیاز نتایج
       ========================================================= */

    function calculateResultScore() {

        let weightedSum = 0;

        let totalWeight = 0;


        for (let i = 0; i < 7; i++) {

            const weight =
                parseInt(
                    document.getElementById(
                        `resultWeight_${i}`
                    ).value
                );


            const statusIndex =
                document.getElementById(
                    `resultStatus_${i}`
                ).value;


            if (
                !isNaN(weight) &&
                statusIndex !== ""
            ) {

                const score =
                    resultStatuses[
                        parseInt(statusIndex)
                    ].score;


                weightedSum +=
                    score * weight;


                totalWeight +=
                    weight;
            }
        }


        if (totalWeight === 0) {
            return null;
        }


        return Math.round(
            weightedSum / totalWeight
        );
    }


    /* =========================================================
       محاسبه امتیاز شایستگی
       ========================================================= */

    function calculateCompetencyScore() {

        let sum = 0;

        let count = 0;


        currentCompetencies.forEach(
            (competency, index) => {

                const selected =
                    document.getElementById(
                        `competency_${index}`
                    ).value;


                if (selected !== "") {

                    const score =
                        competencyLevels[
                            parseInt(selected)
                        ].score;


                    sum += score;

                    count++;
                }
            }
        );


        if (count === 0) {
            return null;
        }


        return Math.round(
            sum / count
        );
    }


    /* =========================================================
       Grade
       ========================================================= */

    function getGrade(score) {

        if (score === null) {
            return "-";
        }

        if (score >= 96) {
            return "A+";
        }

        if (score >= 91) {
            return "A";
        }

        if (score >= 76) {
            return "B+";
        }

        if (score >= 66) {
            return "B";
        }

        if (score >= 51) {
            return "C";
        }

        if (score >= 31) {
            return "D";
        }

        return "E";
    }


    /* =========================================================
       محاسبه کلی امتیازها
       ========================================================= */

    function calculateScores() {

        const resultScore =
            calculateResultScore();


        const competencyScore =
            calculateCompetencyScore();


        document.getElementById(
            "resultScore"
        ).innerText =

            resultScore === null
                ? "-"
                : resultScore;


        document.getElementById(
            "competencyScore"
        ).innerText =

            competencyScore === null
                ? "-"
                : competencyScore;


        if (
            resultScore !== null &&
            competencyScore !== null
        ) {

            const finalScore =
                Math.round(
                    (resultScore +
                        competencyScore) / 2
                );


            document.getElementById(
                "finalScore"
            ).innerText = finalScore;


            document.getElementById(
                "finalGrade"
            ).innerText =
                getGrade(finalScore);

        }
        else {

            document.getElementById(
                "finalScore"
            ).innerText = "-";


            document.getElementById(
                "finalGrade"
            ).innerText = "-";
        }

    }


    /* =========================================================
       کنترل چک‌باکس‌های شواهد رفتاری
       ========================================================= */

    function competencyChanged(index) {

        const selected =
            document.getElementById(
                `competency_${index}`
            ).value;


        const cards =
            document.querySelectorAll(
                `.behavior-item[data-competency="${index}"]`
            );


        const selectedIndex =
            selected === ""
                ? -1
                : parseInt(selected);


        /*
           چک‌باکس برای:

           دو سطح بالایی:
           0 = فوق العاده
           1 = فراتر از حد انتظار

           دو سطح پایینی:
           5 = نیاز به تلاش بیشتر
           6 = غیرقابل پذیرش
        */

        const showChecks =
            selectedIndex === 0 ||
            selectedIndex === 1 ||
            selectedIndex === 5 ||
            selectedIndex === 6;


        cards.forEach(card => {

            const checkbox =
                card.querySelector(
                    ".behavior-check"
                );


            if (showChecks) {

                card.classList.add(
                    "show-check"
                );

            }
            else {

                card.classList.remove(
                    "show-check"
                );

                checkbox.checked = false;
            }

        });


        calculateScores();
    }


