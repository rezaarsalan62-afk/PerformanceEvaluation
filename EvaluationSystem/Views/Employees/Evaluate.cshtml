    /* =========================================================
       ثبت ارزیابی - فعلاً آزمایشی
       ========================================================= */

    function saveEvaluation() {

        const errors = [];


        /* =========================================================
           1. کنترل کامل بودن ارزیابی شایستگی‌ها
           ========================================================= */

        currentCompetencies.forEach(
            (competency, index) => {

                const selected =
                    document.getElementById(
                        `competency_${index}`
                    ).value;


                if (selected === "") {

                    errors.push(
                        `شایستگی «${competency.title}» ارزیابی نشده است.`
                    );

                    return;
                }


                const selectedIndex =
                    parseInt(selected);


                /*
                   برای دو سطح اول و دو سطح آخر،
                   حداقل یک مصداق رفتاری باید انتخاب شود.
                */

                const requiresBehavior =
                    selectedIndex === 0 ||
                    selectedIndex === 1 ||
                    selectedIndex === 5 ||
                    selectedIndex === 6;


                if (requiresBehavior) {

                    const checkedBehaviors =
                        document.querySelectorAll(
                            `.behavior-check[data-competency="${index}"]:checked`
                        );


                    if (
                        checkedBehaviors.length === 0
                    ) {

                        errors.push(
                            `برای شایستگی «${competency.title}» حداقل یک مصداق رفتاری باید انتخاب شود.`
                        );
                    }
                }

            }
        );


        /* =========================================================
           2. کنترل وظایف / پروژه‌ها / اقدامات
           ========================================================= */

        let enteredTasks = 0;


        for (let i = 0; i < 7; i++) {

            const text =
                document.getElementById(
                    `resultText_${i}`
                ).value.trim();


            const weight =
                document.getElementById(
                    `resultWeight_${i}`
                ).value;


            const status =
                document.getElementById(
                    `resultStatus_${i}`
                ).value;


            /*
               اگر وظیفه درج شده باشد،
               باید هم وزن و هم وضعیت داشته باشد.
            */

            if (text !== "") {

                enteredTasks++;


                if (weight === "") {

                    errors.push(
                        `وظیفه ردیف ${i + 1} دارای وزن نیست.`
                    );
                }


                if (status === "") {

                    errors.push(
                        `وضعیت انجام وظیفه ردیف ${i + 1} مشخص نشده است.`
                    );
                }
            }


            /*
               اگر وزن یا وضعیت وارد شده ولی عنوان وظیفه خالی باشد،
               این ردیف هم ناقص محسوب می‌شود.
            */

            if (
                text === "" &&
                (
                    weight !== "" ||
                    status !== ""
                )
            ) {

                errors.push(
                    `ردیف ${i + 1} دارای اطلاعات ناقص است؛ عنوان وظیفه، اقدام یا پروژه را وارد کنید.`
                );
            }

        }


        /* =========================================================
           3. حداقل سه وظیفه
           ========================================================= */

        if (enteredTasks < 3) {

            errors.push(
                `حداقل ۳ وظیفه، اقدام یا پروژه باید در بخش نتایج درج شود.`
            );
        }


        /* =========================================================
           4. نمایش خطاها
           ========================================================= */

        if (errors.length > 0) {

            alert(
                "امکان ثبت ارزیابی وجود ندارد:\n\n" +

                errors
                    .map(
                        (error, index) =>
                            `${index + 1}. ${error}`
                    )
                    .join("\n")
            );

            return;
        }


        /* =========================================================
           5. محاسبه امتیازها
           ========================================================= */

        calculateScores();


        const resultScore =
            calculateResultScore();


        const competencyScore =
            calculateCompetencyScore();


        const finalScore =
            Math.round(
                (resultScore +
                    competencyScore) / 2
            );


        const grade =
            getGrade(finalScore);


        /* =========================================================
           6. ثبت موفق - فعلاً آزمایشی
           ========================================================= */

        alert(
            "ثبت ارزیابی با موفقیت انجام شد.\n\n" +

            "امتیاز نتایج: " +
            resultScore +
            "\n" +

            "امتیاز شایستگی: " +
            competencyScore +
            "\n" +

            "امتیاز نهایی عملکرد: " +
            finalScore +
            "\n" +

            "وضعیت نهایی عملکرد: " +
            grade
        );
    }


    /* =========================================================
       ارزیابی مجدد
       ========================================================= */

    function reevaluate() {

        const confirmed =
            confirm(
                "آیا می‌خواهید اطلاعات ارزیابی دوباره پاک شود؟"
            );


        if (!confirmed) {
            return;
        }


        for (let i = 0; i < 7; i++) {

            document.getElementById(
                `resultText_${i}`
            ).value = "";


            document.getElementById(
                `resultWeight_${i}`
            ).value = "";


            document.getElementById(
                `resultStatus_${i}`
            ).value = "";
        }


        currentCompetencies.forEach(
            (competency, index) => {

                document.getElementById(
                    `competency_${index}`
                ).value = "";

            }
        );


        document
            .querySelectorAll(
                ".behavior-check"
            )
            .forEach(
                check => {

                    check.checked = false;

                }
            );


        document
            .querySelectorAll(
                ".behavior-item"
            )
            .forEach(
                item => {

                    item.classList.remove(
                        "show-check"
                    );

                }
            );


        document.getElementById(
            "improvementText"
        ).value = "";


        calculateScores();
    }


    /* =========================================================
       نمایش کارنامه - فعلاً آزمایشی
       ========================================================= */

    function showReport() {

        calculateScores();


        const resultScore =
            calculateResultScore();


        const competencyScore =
            calculateCompetencyScore();


        if (resultScore === null) {

            alert(
                "برای نمایش کارنامه، حداقل یک نتیجه باید ارزیابی شده باشد."
            );

            return;
        }


        if (competencyScore === null) {

            alert(
                "برای نمایش کارنامه، تمام شایستگی‌ها باید ارزیابی شده باشند."
            );

            return;
        }


        const finalScore =
            Math.round(
                (resultScore +
                    competencyScore) / 2
            );


        const grade =
            getGrade(finalScore);


        const employeeCode =
            @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    Model.Employee.PersonnelCode
                )
            );


        const employeeName =
            @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    Model.Employee.FirstName +
                    " " +
                    Model.Employee.LastName
                )
            );


        const jobTitle =
            @Html.Raw(
