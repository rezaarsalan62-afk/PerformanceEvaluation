                    Model.Job.Title
                )
            );


        const evaluatorName =
            @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    User.Identity?.Name ?? ""
                )
            );


        const evaluationPeriod =
            "۱۴۰۵";


        /* =========================================================
           آماده‌سازی نتایج
           ========================================================= */

        let resultsHtml = "";


        for (let i = 0; i < 7; i++) {

            const text =
                document.getElementById(
                    `resultText_${i}`
                ).value.trim();


            const weight =
                document.getElementById(
                    `resultWeight_${i}`
                ).value;


            const statusIndex =
                document.getElementById(
                    `resultStatus_${i}`
                ).value;


            if (text !== "") {

                let statusScore = "-";


                if (statusIndex !== "") {

                    statusScore =
                        resultStatuses[
                            parseInt(statusIndex)
                        ].score;
                }


                resultsHtml += `

                    <tr>

                        <td>
                            ${i + 1}
                        </td>

                        <td class="result-task">
                            ${escapeHtml(text)}
                        </td>

                        <td>
                            ${weight || "-"}
                        </td>

                        <td>
                            ${statusScore}
                        </td>

                    </tr>
                `;
            }
        }


        /* =========================================================
           آماده‌سازی شایستگی‌ها
           ========================================================= */

        let competencyRows = [];


        currentCompetencies.forEach(
            (competency, index) => {

                const selected =
                    document.getElementById(
                        `competency_${index}`
                    ).value;


                let levelText = "-";

                let score = 0;

                let selectedLevel = -1;


                if (selected !== "") {

                    selectedLevel =
                        parseInt(selected);


                    levelText =
                        competencyLevels[
                            selectedLevel
                        ].text;


                    score =
                        competencyLevels[
                            selectedLevel
                        ].score;
                }


                let selectedBehaviors = [];


                document
                    .querySelectorAll(
                        `.behavior-check[data-competency="${index}"]:checked`
                    )
                    .forEach(
                        check => {

                            const behaviorIndex =
                                parseInt(
                                    check.dataset.behavior
                                );


                            selectedBehaviors.push(
                                competency.behaviors[
                                    behaviorIndex
                                ]
                            );

                        }
                    );


                competencyRows.push({

                    title:
                        competency.title,

                    levelText:
                        levelText,

                    score:
                        score,

                    levelIndex:
                        selectedLevel,

                    behaviors:
                        competency.behaviors,

                    selectedBehaviors:
                        selectedBehaviors

                });

            }
        );


        /* =========================================================
           تقسیم شایستگی‌ها بین دو صفحه
           ========================================================= */

        const middle =
            Math.ceil(
                competencyRows.length / 2
            );


        const firstPageCompetencies =
            competencyRows.slice(
                0,
                middle
            );


        const secondPageCompetencies =
            competencyRows.slice(
                middle
            );


        function createCompetencyHtml(items) {

            let html = "";


            items.forEach(item => {

                let behaviorsHtml = "";


                item.behaviors.forEach(
                    behavior => {

                        const isSelected =
                            item.selectedBehaviors
                                .includes(behavior);


                        behaviorsHtml += `

                            <div class="behavior">

                                ${
                                    isSelected
                                        ? `<span class="selected-mark">✓</span>`
                                        : ""
                                }

                                ${escapeHtml(behavior)}

                            </div>
                        `;
                    }
                );


                html += `

                    <div class="competency-box">

                        <div class="competency-title">
                            ${escapeHtml(item.title)}
                        </div>

                        <div class="competency-content">

                            <div class="competency-level">

                                <div class="level-label">
                                    وضعیت ارزیابی
                                </div>

                                <div class="level-value">
                                    ${escapeHtml(item.levelText)}
                                </div>

                            </div>

                            <div class="behaviors">

                                <div class="behaviors-title">
                                    مصادیق رفتاری
                                </div>

                                <div class="behavior-grid">
                                    ${behaviorsHtml}
                                </div>

                            </div>

                        </div>

                    </div>
                `;
            });


            return html;
        }


        /* =========================================================
           مصادیق مثبت و قابل بهبود
           ========================================================= */

        let positiveBehaviors = [];

        let improvementBehaviors = [];


        competencyRows.forEach(
            item => {

                if (
                    item.levelIndex === 0 ||
                    item.levelIndex === 1
                ) {

                    positiveBehaviors.push(
                        ...item.selectedBehaviors
                    );

                }


                if (
                    item.levelIndex === 5 ||
                    item.levelIndex === 6
                ) {

                    improvementBehaviors.push(
                        ...item.selectedBehaviors
                    );

                }

            }
        );


        function createBulletList(items) {

            if (
                items.length === 0
            ) {

                return `

                    <div class="empty-message">
                        موردی ثبت نشده است
                    </div>

                `;
            }


            return items
                .map(
                    item => `

                        <div class="bullet-item">
                            • ${escapeHtml(item)}
                        </div>

                    `
                )
                .join("");
        }


        /* =========================================================
           داده نمودار راداری
           ========================================================= */

        const radarItems =
            competencyRows.map(
                item => ({

                    title:
                        item.title,

                    score:
                        item.score

                })
            );


        function createRadarChart(items) {

            const width = 390;

            const height = 300;

            const centerX = 195;

            const centerY = 150;

            const radius = 105;

            const count = items.length;


            if (count === 0) {
                return "";
            }


            function point(index, r) {

                const angle =
                    (-Math.PI / 2) +
                    (
                        (Math.PI * 2 * index) /
                        count
                    );


                return {

                    x:
                        centerX +
                        Math.cos(angle) *
                        r,

                    y:
                        centerY +
                        Math.sin(angle) *
                        r

                };
            }


            let gridHtml = "";


            const levels =
                [20, 40, 60, 80, 100];


            levels.forEach(
                level => {

                    const points = [];


                    for (
                        let i = 0;
                        i < count;
                        i++
                    ) {

                        const p =
                            point(
                                i,
                                radius *
                                level /
                                100
                            );


                        points.push(
                            `${p.x},${p.y}`
                        );
                    }


                    gridHtml += `

                        <polygon
                            points="${points.join(" ")}"
                            fill="none"
                            stroke="#b8bec5"
                            stroke-width="1">
                        </polygon>

                    `;
                }
            );


            let axisHtml = "";

            let labelHtml = "";


            items.forEach(
                (item, index) => {

                    const outer =
                        point(
                            index,
                            radius
                        );


                    const label =
                        point(
                            index,
                            radius + 35
                        );


                    axisHtml += `

                        <line
                            x1="${centerX}"
                            y1="${centerY}"
                            x2="${outer.x}"
                            y2="${outer.y}"
                            stroke="#c8ccd1"
                            stroke-width="1">
                        </line>

                    `;


                    labelHtml += `

                        <text
                            x="${label.x}"
                            y="${label.y}"
                            text-anchor="middle"
                            font-size="10"
                            fill="#333">

                            ${escapeHtml(
                                shortenText(
                                    item.title,
                                    18
                                )
                            )}

                        </text>

                    `;
                }
            );


            const valuePoints = [];


            items.forEach(
                (item, index) => {

                    const value =
                        Math.max(
                            0,
                            item.score
                        );


                    const p =
                        point(
                            index,
                            radius *
                            value /
                            100
                        );


                    valuePoints.push(
                        `${p.x},${p.y}`
                    );

                }
            );


            let dotsHtml = "";


            items.forEach(
                (item, index) => {

                    const p =
                        point(
                            index,
                            radius *
                            item.score /
                            100
                        );


                    dotsHtml += `

                        <circle
                            cx="${p.x}"
                            cy="${p.y}"
                            r="4"
                            fill="#f28c28">
                        </circle>

                    `;
                }
            );


            return `

                <svg
                    width="${width}"
                    height="${height}"
                    viewBox="0 0 ${width} ${height}">

                    ${gridHtml}

                    ${axisHtml}

                    <polygon
                        points="${valuePoints.join(" ")}"
                        fill="rgba(242,140,40,.18)"
                        stroke="#f28c28"
                        stroke-width="2">
                    </polygon>

                    ${dotsHtml}

                    ${labelHtml}

                </svg>

            `;
        }


        /* =========================================================
           ساخت کارنامه
           ========================================================= */

        const reportWindow =
            window.open(
                "",
                "_blank"
            );


        if (!reportWindow) {

            alert(
                "مرورگر اجازه باز کردن صفحه جدید را نداده است. لطفاً Popup را برای این سایت فعال کنید."
            );

            return;
        }


        reportWindow.document.write(`

