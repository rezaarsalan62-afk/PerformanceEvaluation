@model EvaluationSystem.Models.ViewModels.EvaluationFormViewModel

@{
    ViewData["Title"] = "فرم ارزیابی عملکرد";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        direction: rtl;
    }

    .evaluation-page {
        direction: rtl;
        padding: 25px;
        background: #f5f6f8;
        min-height: 100vh;
    }

    .page-title {
        text-align: center;
        margin-bottom: 20px;
    }

    .page-title h2 {
        margin: 0;
        font-weight: 700;
    }

    /* مشخصات کارمند */

    .employee-info {
        background: white;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
    }

    .employee-info-title {
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 15px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e5e7eb;
    }

    .employee-info-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
    }

    .info-box {
        background: #f8f9fa;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 12px;
    }

    .info-label {
        font-size: 12px;
        color: #6b7280;
        margin-bottom: 5px;
    }

    .info-value {
        font-weight: 600;
    }

    /* ساختار اصلی */

    .evaluation-layout {
        display: grid;
        grid-template-columns: 290px minmax(0, 1fr);
        gap: 20px;
        align-items: start;
    }

    /* سایدبار */

    .sidebar {
        background: white;
        border-radius: 12px;
        padding: 18px;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
        position: sticky;
        top: 20px;
    }

    .sidebar-title {
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 18px;
        padding-bottom: 12px;
        border-bottom: 1px solid #e5e7eb;
    }

    .summary-item {
        margin-bottom: 14px;
    }

    .summary-label {
        display: block;
        font-size: 12px;
        color: #6b7280;
        margin-bottom: 6px;
    }

    .summary-value {
        width: 100%;
        border: 1px solid #dfe3e8;
        background: #f8f9fa;
        border-radius: 7px;
        padding: 9px;
        font-weight: 700;
        text-align: center;
    }

    .grade-value {
        font-size: 21px;
        font-weight: 800;
    }

    .sidebar-buttons {
        display: flex;
        flex-direction: column;
        gap: 9px;
        margin-top: 20px;
    }

    .sidebar-buttons button,
    .sidebar-buttons a {
        width: 100%;
        min-height: 42px;
    }

    .improvement-title {
        margin-top: 22px;
        margin-bottom: 7px;
        font-size: 13px;
        font-weight: 700;
    }

    .improvement-text {
        width: 100%;
        min-height: 130px;
        resize: vertical;
        border: 1px solid #dfe3e8;
        border-radius: 8px;
        padding: 10px;
        direction: rtl;
    }

    /* محتوای اصلی */

    .main-content {
        min-width: 0;
    }

    .tabs {
        display: flex;
        gap: 6px;
        background: white;
        border-radius: 10px;
        padding: 6px;
        margin-bottom: 15px;
        box-shadow: 0 2px 8px rgba(0,0,0,.05);
    }

    .tab-button {
        flex: 1;
        border: none;
        padding: 13px;
        border-radius: 8px;
        background: transparent;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
    }

    .tab-button.active {
        background: #212529;
        color: white;
    }

    .tab-content {
        display: none;
    }

    .tab-content.active {
        display: block;
    }

    .section-card {
        background: white;
        border-radius: 12px;
        padding: 18px;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
        margin-bottom: 18px;
    }

    .section-header {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 18px;
    }

    /* تب نتایج */

    .result-header {
        display: grid;
        grid-template-columns: minmax(280px, 1fr) 100px 300px 45px;
        gap: 10px;
        margin-bottom: 8px;
        font-size: 12px;
        color: #6b7280;
        font-weight: 700;
        padding: 0 5px;
    }

    .result-row {
        display: grid;
        grid-template-columns: minmax(280px, 1fr) 100px 300px 45px;
        gap: 10px;
        align-items: center;
        margin-bottom: 10px;
    }

    .result-text {
        width: 100%;
        min-height: 58px;
        resize: vertical;
        border: 1px solid #dfe3e8;
        border-radius: 8px;
        padding: 10px;
        direction: rtl;
    }

    .result-select {
        width: 100%;
        min-height: 44px;
        border: 1px solid #dfe3e8;
        border-radius: 8px;
        padding: 8px;
        direction: rtl;
        background: white;
    }

    .list-button {
        width: 42px;
        height: 42px;
        border-radius: 8px;
        border: 1px solid #cfd4da;
        background: white;
        font-size: 20px;
        cursor: pointer;
    }

    .list-button:hover {
        background: #f1f3f5;
    }

    .result-note {
        margin-top: 15px;
        padding: 12px;
        border-radius: 8px;
        background: #f8f9fa;
        border: 1px solid #e5e7eb;
        font-size: 13px;
        color: #6b7280;
    }

    /* تب شایستگی */

    .competency-card {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 15px;
        background: white;
    }

    .competency-layout {
        display: grid;
        grid-template-columns: 220px minmax(0, 1fr);
        gap: 20px;
        align-items: start;
    }

    .competency-info {
        border-left: 1px solid #e5e7eb;
        padding-left: 15px;
    }

    .competency-title {
        font-size: 16px;
        font-weight: 700;
        line-height: 1.8;
        margin-bottom: 14px;
    }

    .competency-select {
        width: 100%;
        min-height: 45px;
        border: 1px solid #ced4da;
        border-radius: 8px;
        padding: 8px;
        background: white;
        direction: rtl;
    }

    .behaviors-title {
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 10px;
        color: #495057;
    }

    .behavior-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .behavior-item {
        border: 1px solid #edf0f2;
        border-radius: 7px;
        padding: 9px 10px;
        background: transparent;
        line-height: 1.8;
        font-size: 13px;
    }

    .behavior-check {
        display: none;
        margin-left: 7px;
    }

    .behavior-item.show-check .behavior-check {
        display: inline-block;
    }

    /* پنجره انتخاب شرح وظایف */

    .duty-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        padding: 20px;
    }

    .duty-modal-backdrop.show {
        display: flex;
    }

    .duty-modal {
        width: min(800px, 100%);
        max-height: 85vh;
        overflow: auto;
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 15px 50px rgba(0,0,0,.2);
    }

    .duty-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid #e5e7eb;
    }

    .duty-modal-header h4 {
        margin: 0;
    }

    .duty-close {
        border: none;
        background: transparent;
        font-size: 25px;
        cursor: pointer;
    }

    .duty-filters {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin-bottom: 20px;
    }

    .duty-filter-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .duty-filter-group label {
        font-size: 12px;
        font-weight: 700;
        color: #495057;
    }

    .duty-select {
        width: 100%;
        min-height: 44px;
        border: 1px solid #dfe3e8;
        border-radius: 8px;
        padding: 8px 10px;
        background: white;
        direction: rtl;
        font-family: inherit;
    }

    .duty-section-title {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .duty-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .duty-item {
        text-align: right;
        border: 1px solid #e1e5e9;
        border-radius: 8px;
        background: white;
        padding: 11px;
        cursor: pointer;
        line-height: 1.8;
        width: 100%;
        font-family: inherit;
        font-size: 13px;
    }

    .duty-item:hover {
        background: #f0f2f4;
    }

    .duty-loading,
    .duty-empty {
        text-align: center;
        color: #6b7280;
        padding: 20px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
    }

    /* ریسپانسیو */

    @@media (max-width: 1100px) {

        .evaluation-layout {
            grid-template-columns: 1fr;
        }

        .sidebar {
            position: static;
        }

        .employee-info-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 800px) {

        .result-header {
            display: none;
        }

        .result-row {
            grid-template-columns: 1fr;
        }

        .list-button {
            width: 100%;
        }

        .competency-layout {
            grid-template-columns: 1fr;
        }

        .competency-info {
            border-left: none;
            border-bottom: 1px solid #e5e7eb;
            padding-left: 0;
            padding-bottom: 15px;
        }

        .behavior-grid {
            grid-template-columns: 1fr;
        }

        .employee-info-grid {
            grid-template-columns: 1fr;
        }

        .duty-filters {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="evaluation-page">

    <!-- عنوان -->
    <div class="page-title">
        <h2>فرم ارزیابی عملکرد کارکنان</h2>
    </div>

    <!-- مشخصات کارمند -->
    <div class="employee-info">

        <div class="employee-info-title">
            مشخصات کارمند
        </div>

        <div class="employee-info-grid">

            <div class="info-box">
                <div class="info-label">کد پرسنلی</div>
                <div class="info-value">
                    @Model.Employee.PersonnelCode
                </div>
            </div>

            <div class="info-box">
                <div class="info-label">نام و نام خانوادگی</div>
                <div class="info-value">
                    @Model.Employee.FirstName @Model.Employee.LastName
                </div>
            </div>

            <div class="info-box">
                <div class="info-label">واحد سازمانی</div>
                <div class="info-value">
                    -
                </div>
            </div>

            <div class="info-box">
                <div class="info-label">عنوان پست سازمانی</div>
                <div class="info-value">
                    @Model.Job.Title
                </div>
            </div>

        </div>
    </div>

    <!-- ساختار اصلی -->
    <div class="evaluation-layout">

        <!-- سایدبار سمت راست -->
        <aside class="sidebar">

            <div class="sidebar-title">
                اطلاعات ارزیابی
            </div>

            <div class="summary-item">
                <span class="summary-label">
                    دوره ارزیابی
                </span>

                <div class="summary-value">
                    ۱۴۰۵
                </div>
            </div>

            <div class="summary-item">
                <span class="summary-label">
                    امتیاز ارزیابی شایستگی
                </span>

                <div id="competencyScore"
                     class="summary-value">
                    -
                </div>
            </div>

            <div class="summary-item">
                <span class="summary-label">
                    امتیاز ارزیابی نتایج
                </span>

                <div id="resultScore"
                     class="summary-value">
                    -
                </div>
            </div>

            <div class="summary-item">
                <span class="summary-label">
                    امتیاز نهایی عملکرد
                </span>

                <div id="finalScore"
                     class="summary-value">
                    -
                </div>
            </div>

            <div class="summary-item">
                <span class="summary-label">
                    وضعیت نهایی عملکرد
                </span>

                <div id="finalGrade"
                     class="summary-value grade-value">
                    -
                </div>
            </div>

            <div class="sidebar-buttons">

                <button type="button"
                        class="btn btn-primary"
                        onclick="saveEvaluation()">
                    ثبت ارزیابی
                </button>

                <a asp-controller="Employees"
                   asp-action="Index"
                   class="btn btn-secondary">
                    انصراف
                </a>

                <button type="button"
                        class="btn btn-warning"
                        onclick="reevaluate()">
                    ارزیابی مجدد
                </button>

                <button type="button"
                        class="btn btn-outline-primary"
                        onclick="showReport()">
                    نمایش کارنامه
                </button>

            </div>

            <div class="improvement-title">
                مهم‌ترین پیشنهادات بهبود
            </div>

            <textarea id="improvementText"
                      class="improvement-text"
                      placeholder="مهم‌ترین پیشنهادات بهبود را وارد کنید..."></textarea>

        </aside>

        <!-- محتوای اصلی -->
        <main class="main-content">

            <!-- تب‌ها -->
            <div class="tabs">

                <button type="button"
                        id="tabResultsButton"
                        class="tab-button active"
                        onclick="openTab('results')">
                    ارزیابی نتایج
                </button>

                <button type="button"
                        id="tabCompetenciesButton"
                        class="tab-button"
                        onclick="openTab('competencies')">
                    ارزیابی شایستگی‌ها
                </button>

            </div>

            <!-- تب نتایج -->
            <section id="resultsTab"
                     class="tab-content active">

                <div class="section-card">

                    <div class="section-header">
                        ارزیابی نتایج
                    </div>

                    <div class="result-header">
                        <div>
                            وظیفه / اقدام / پروژه
                        </div>

                        <div>
                            وزن
                        </div>

                        <div>
                            وضعیت انجام
                        </div>

                        <div></div>
                    </div>

                    <div id="resultRows"></div>

                </div>

            </section>

            <!-- تب شایستگی -->
            <section id="competenciesTab"
                     class="tab-content">

                <div class="section-card">

                    <div class="section-header">
                        ارزیابی شایستگی‌های عمومی
                    </div>

                    <div id="competencyContainer"></div>

                </div>

            </section>

        </main>

    </div>

</div>

<!-- ==========================================
     پنجره انتخاب شرح وظایف
     ========================================== -->

<div id="dutyModalBackdrop"
     class="duty-modal-backdrop">

    <div class="duty-modal">

        <div class="duty-modal-header">

            <h4>
                انتخاب از شرح وظایف
            </h4>

            <button type="button"
                    class="duty-close"
                    onclick="closeDutyModal()">
                ×
            </button>

        </div>

        <!-- رسته و شغل -->
        <div class="duty-filters">

            <div class="duty-filter-group">

                <label for="dutyJobCategory">
                    رسته شغلی
                </label>

                <select id="dutyJobCategory"
                        class="duty-select"
                        onchange="loadJobsForSelectedCategory()">

                    <option value="">
                        در حال بارگذاری...
                    </option>

                </select>

            </div>

            <div class="duty-filter-group">

                <label for="dutyJob">
                    عنوان شغلی
                </label>

                <select id="dutyJob"
                        class="duty-select"
                        onchange="loadDutiesForSelectedJob()">

                    <option value="">
                        ابتدا رسته را انتخاب کنید
                    </option>

                </select>

            </div>

        </div>

        <!-- لیست شرح وظایف -->
        <div class="duty-section-title">
            شرح وظایف
        </div>

        <div class="duty-list"
             id="dutyList">
        </div>

    </div>

</div>


