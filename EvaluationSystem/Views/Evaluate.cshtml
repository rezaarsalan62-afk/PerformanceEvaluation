@model EvaluationSystem.Models.ViewModels.EvaluationFormViewModel

@{
    var employeeFullName =
        Model.Employee.FirstName + " " + Model.Employee.LastName;

    var currentJobCategoryId = Model.Job.JobCategoryId;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>فرم ارزیابی عملکرد</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px;
            font-family: Tahoma, Arial, sans-serif;
            direction: rtl;
            background: #f5f6f8;
            color: #222;
        }

        .page-container {
            max-width: 1400px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        }

        .page-title {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 25px;
        }

        .employee-info {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-bottom: 30px;
        }

        .info-box {
            background: #f8f9fb;
            border: 1px solid #e1e4e8;
            border-radius: 8px;
            padding: 15px;
        }

        .info-label {
            display: block;
            color: #666;
            font-size: 13px;
            margin-bottom: 7px;
        }

        .info-value {
            font-weight: bold;
            font-size: 15px;
        }

        .section-title {
            font-size: 19px;
            font-weight: bold;
            margin: 30px 0 18px;
            border-right: 4px solid #555;
            padding-right: 10px;
        }

        .results-table-wrapper {
            overflow-x: auto;
        }

        .results-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .results-table th,
        .results-table td {
            border: 1px solid #d9dde3;
            padding: 10px;
            vertical-align: middle;
        }

        .results-table th {
            background: #f1f3f6;
            font-weight: bold;
            text-align: center;
        }

        .results-table th:nth-child(1) {
            width: 52%;
        }

        .results-table th:nth-child(2) {
            width: 18%;
        }

        .results-table th:nth-child(3) {
            width: 22%;
        }

        .results-table th:nth-child(4) {
            width: 8%;
        }

        .task-cell {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .task-input {
            flex: 1;
            min-width: 0;
            border: 1px solid #ccd2d9;
            border-radius: 6px;
            padding: 10px;
            font-family: inherit;
            font-size: 13px;
            min-height: 42px;
        }

        .task-input:focus {
            outline: none;
            border-color: #555;
        }

        .duty-button {
            width: 38px;
            height: 38px;
            border: 1px solid #bfc5cc;
            background: #fff;
            border-radius: 6px;
            cursor: pointer;
            font-size: 17px;
            flex-shrink: 0;
        }

        .duty-button:hover {
            background: #f0f2f5;
        }

        .select-control {
            width: 100%;
            padding: 9px;
            border: 1px solid #ccd2d9;
            border-radius: 6px;
            font-family: inherit;
            background: white;
        }

        .criteria-card {
            border: 1px solid #e0e3e7;
            border-radius: 10px;
            padding: 18px;
            margin-bottom: 18px;
            background: #fff;
        }

        .criteria-title {
            font-weight: bold;
            font-size: 16px;
            margin-bottom: 8px;
        }

        .criteria-description {
            color: #666;
            margin-bottom: 15px;
            line-height: 1.8;
        }

        .score-options {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .score-option {
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
        }

        .comment-box {
            width: 100%;
            min-height: 130px;
            border: 1px solid #ccd2d9;
            border-radius: 8px;
            padding: 12px;
            font-family: inherit;
            resize: vertical;
        }

        .action-bar {
            display: flex;
            gap: 10px;
            margin-top: 25px;
        }

        .primary-button,
        .secondary-button {
            border: none;
            border-radius: 7px;
            padding: 11px 25px;
            font-family: inherit;
            cursor: pointer;
            font-size: 14px;
        }

        .primary-button {
            background: #333;
            color: white;
        }

        .secondary-button {
            background: #e9ecef;
            color: #333;
        }

        /* =========================
           پنجره انتخاب شرح وظایف
           ========================= */

        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.45);
            z-index: 9999;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-overlay.show {
            display: flex;
        }

        .duty-modal {
            width: 100%;
            max-width: 900px;
            max-height: 90vh;
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 35px rgba(0,0,0,0.20);
            display: flex;
            flex-direction: column;
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 22px;
            border-bottom: 1px solid #e2e5e9;
        }

        .modal-title {
            font-size: 18px;
            font-weight: bold;
        }

        .modal-close {
            border: none;
            background: transparent;
            font-size: 24px;
            cursor: pointer;
            color: #666;
        }

        .modal-body {
            padding: 22px;
            overflow-y: auto;
        }

        .filter-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 22px;
        }

        .filter-group label {
            display: block;
            margin-bottom: 7px;
            font-weight: bold;
            font-size: 13px;
        }

        .duty-section-title {
            font-weight: bold;
            margin-bottom: 10px;
        }

        .duties-list {
            border: 1px solid #e0e3e7;
            border-radius: 8px;
            overflow: hidden;
        }

        .duty-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 13px 15px;
            border-bottom: 1px solid #edf0f2;
            cursor: pointer;
            transition: background 0.15s;
        }

        .duty-item:last-child {
            border-bottom: none;
        }

        .duty-item:hover {
            background: #f6f7f9;
        }

        .duty-item input {
            width: 17px;
            height: 17px;
            flex-shrink: 0;
        }

        .duty-text {
            line-height: 1.8;
            font-size: 14px;
        }

        .empty-message {
            padding: 25px;
            text-align: center;
            color: #777;
        }

        .modal-footer {
            padding: 15px 22px;
            border-top: 1px solid #e2e5e9;
            display: flex;
            justify-content: flex-start;
            gap: 10px;
        }

        .select-duty-button {
            background: #333;
            color: white;
            border: none;
            border-radius: 7px;
            padding: 10px 22px;
            font-family: inherit;
            cursor: pointer;
        }

        .cancel-duty-button {
            background: #e9ecef;
            color: #333;
            border: none;
            border-radius: 7px;
            padding: 10px 22px;
            font-family: inherit;
            cursor: pointer;
        }

        .loading {
            padding: 20px;
            text-align: center;
            color: #777;
        }

        @@media (max-width: 900px) {
            .employee-info {
                grid-template-columns: 1fr;
            }

            .filter-rowlsof -i :5133 {
                grid-template-columns: 1fr;
            }

            body {
                padding: 15px;
            }

            .page-container {
                padding: 18px;
            }
        }
    </style>
</head>

<body>

<div class="page-container">

    <div class="page-title">
        فرم ارزیابی عملکرد
    </div>

    <!-- اطلاعات کارمند -->
    <div class="employee-info">

        <div class="info-box">
            <span class="info-label">نام و نام خانوادگی</span>
            <span class="info-value">
                @Model.Employee.FirstName @Model.Employee.LastName
            </span>
        </div>

        <div class="info-box">
            <span class="info-label">کد پرسنلی</span>
            <span class="info-value">
                @Model.Employee.PersonnelCode
            </span>
        </div>

        <div class="info-box">
            <span class="info-label">شغل اصلی</span>
            <span class="info-value">
                @Model.Job.Title
            </span>
        </div>

    </div>


    <!-- =========================
         ارزیابی نتایج
         ========================= -->

    <div class="section-title">
        ارزیابی نتایج
    </div>

    <div class="results-table-wrapper">

        <table class="results-table">

            <thead>
                <tr>
                    <th>وظیفه / اقدام / پروژه</th>
                    <th>وزن</th>
                    <th>وضعیت</th>
                    <th>ردیف</th>
                </tr>
            </thead>

            <tbody>

            @for (int i = 0; i < 7; i++)
            {
                <tr>

                    <td>

                        <div class="task-cell">

                            <input type="text"
                                   class="task-input"
                                   id="task_@i"
                                   name="Results[@i].Task"
                                   placeholder="شرح وظیفه، اقدام یا پروژه را وارد کنید" />

                            <button type="button"
                                    class="duty-button"
                                    title="انتخاب از شرح وظایف"
                                    onclick="openDutySelector(@i)">
                                ☷
                            </button>

                        </div>

                    </td>

                    <td>

                        <select class="select-control"
                                name="Results[@i].Weight">

                            <option value="">انتخاب</option>
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>

                        </select>

                    </td>

                    <td>

                        <select class="select-control"
                                name="Results[@i].Status">

                            <option value="">انتخاب وضعیت</option>

                            <option value="100">
                                انجام کلیه اقدامات لازم، به نحو مطلوب و قابل قبول
                            </option>

                            <option value="75">
                                انجام اکثر اقدامات مربوطه و تاحدودی قابل قبول
                            </option>

                            <option value="50">
                                انجام برخی از اقدامات لازم و نیازمند بهبود اساسی
                            </option>

                            <option value="25">
                                انجام اقدامات جزئی و غیر قابل قبول
                            </option>

                            <option value="0">
                                هیچ اقدامی انجام نشده است
                            </option>

                        </select>

                    </td>

                    <td style="text-align:center;">
                        @(i + 1)
                    </td>

                </tr>
            }

            </tbody>

        </table>

    </div>


    <!-- =========================
         معیارهای ارزیابی
         ========================= -->

    <div class="section-title">
        معیارهای ارزیابی
    </div>

    @foreach (var item in Model.Items)
    {
        <div class="criteria-card">

            <div class="criteria-title">
                @item.Criterion.Title
            </div>

            <div class="criteria-description">
                @item.Criterion.Description
            </div>

            <div class="score-options">

                <label class="score-option">
                    <input type="radio"
                           name="score_@item.Criterion.Id"
                           value="1" />
                    خیلی ضعیف
                </label>

                <label class="score-option">
                    <input type="radio"
                           name="score_@item.Criterion.Id"
                           value="2" />
                    ضعیف
                </label>

                <label class="score-option">
                    <input type="radio"
                           name="score_@item.Criterion.Id"
                           value="3" />
                    متوسط
                </label>

                <label class="score-option">
                    <input type="radio"
                           name="score_@item.Criterion.Id"
                           value="4" />
                    خوب
                </label>

                <label class="score-option">
                    <input type="radio"
                           name="score_@item.Criterion.Id"
                           value="5" />
                    عالی
                </label>

            </div>

        </div>
    }


    <!-- =========================
         توضیحات ارزیاب
         ========================= -->

    <div class="section-title">
        توضیحات ارزیاب
    </div>

    <textarea name="Comment"
              class="comment-box"
              placeholder="توضیحات ارزیاب را وارد کنید">@Model.Comment</textarea>


    <div class="action-bar">

        <button type="button"
                class="primary-button"
                onclick="saveEvaluation()">
            ثبت ارزیابی
        </button>

        <button type="button"
                class="secondary-button"
                onclick="window.history.back()">
            انصراف
        </button>

    </div>

</div>


<!-- ==========================================
     پنجره انتخاب از شرح وظایف
     ========================================== -->

<div id="dutyModal"
     class="modal-overlay"
     onclick="handleModalBackgroundClick(event)">

    <div class="duty-modal">

        <div class="modal-header">

            <div class="modal-title">
                انتخاب از شرح وظایف
            </div>

            <button type="button"
                    class="modal-close"
                    onclick="closeDutySelector()">
                ×
            </button>

        </div>


        <div class="modal-body">

            <div class="filter-row">

                <div class="filter-group">

                    <label for="jobCategorySelect">
                        رسته شغلی
                    </label>

                    <select id="jobCategorySelect"
                            class="select-control"
                            onchange="onJobCategoryChanged()">

                        <option value="">
                            در حال بارگذاری...
                        </option>

                    </select>

                </div>


                <div class="filter-group">

                    <label for="jobSelect">
                        عنوان شغلی
                    </label>

                    <select id="jobSelect"
                            class="select-control"
                            onchange="onJobChanged()">

                        <option value="">
                            در حال بارگذاری...
                        </option>

                    </select>

                </div>

            </div>


            <div class="duty-section-title">
                شرح وظایف
            </div>

            <div id="dutiesList"
                 class="duties-list">

                <div class="loading">
                    در حال بارگذاری...
                </div>

            </div>

        </div>


        <div class="modal-footer">

            <button type="button"
                    class="select-duty-button"
                    onclick="selectDuty()">
                انتخاب وظیفه
            </button>

            <button type="button"
                    class="cancel-duty-button"
                    onclick="closeDutySelector()">
                انصراف
            </button>

        </div>

    </div>

</div>


<script>

    // ردیف فعلی که پنجره انتخاب شرح وظایف برای آن باز شده
    let currentResultRow = null;

    // وظیفه انتخاب‌شده
    let selectedDuty = null;

    // شغل اصلی کارمند
    const currentEmployeeJobId = @Model.Job.Id;

    // رسته شغل اصلی کارمند
    const currentEmployeeJobCategoryId = @currentJobCategoryId;


    // ==========================================
    // باز کردن پنجره انتخاب شرح وظایف
    // ==========================================

    async function openDutySelector(rowIndex) {

        currentResultRow = rowIndex;
        selectedDuty = null;

        const modal = document.getElementById("dutyModal");

        modal.classList.add("show");

        document.getElementById("jobCategorySelect").innerHTML =
            '<option value="">در حال بارگذاری...</option>';

        document.getElementById("jobSelect").innerHTML =
            '<option value="">در حال بارگذاری...</option>';

        document.getElementById("dutiesList").innerHTML =
            '<div class="loading">در حال بارگذاری...</div>';

        try {

            await loadJobCategories();

            document.getElementById("jobCategorySelect").value =
                currentEmployeeJobCategoryId;

            await loadJobs(currentEmployeeJobCategoryId);

            document.getElementById("jobSelect").value =
                currentEmployeeJobId;

            await loadDuties(currentEmployeeJobId);

        }
        catch (error) {

            console.error(error);

            document.getElementById("dutiesList").innerHTML =
                '<div class="empty-message">خطا در دریافت اطلاعات</div>';
        }
    }


    // ==========================================
    // دریافت رسته‌ها
    // ==========================================

    async function loadJobCategories() {

        const response =
            await fetch('@Url.Action("GetJobCategories", "Employees")');

        if (!response.ok) {
            throw new Error("خطا در دریافت رسته‌های شغلی");
        }

        const categories = await response.json();

        const select =
            document.getElementById("jobCategorySelect");

        select.innerHTML =
            '<option value="">انتخاب رسته شغلی</option>';

        categories.forEach(category => {

            const option = document.createElement("option");

            option.value = category.id;
            option.textContent = category.title;

            select.appendChild(option);
        });
    }


    // ==========================================
    // وقتی رسته تغییر می‌کند
    // ==========================================

    async function onJobCategoryChanged() {

        const categoryId =
            document.getElementById("jobCategorySelect").value;

        const jobSelect =
            document.getElementById("jobSelect");

        if (!categoryId) {

            jobSelect.innerHTML =
                '<option value="">ابتدا رسته را انتخاب کنید</option>';

            document.getElementById("dutiesList").innerHTML =
                '<div class="empty-message">ابتدا یک شغل را انتخاب کنید</div>';

            return;
        }

        try {

            await loadJobs(categoryId);

            const firstJob =
                jobSelect.options.length > 1
                    ? jobSelect.options[1]
                    : null;

            if (firstJob) {

                jobSelect.value = firstJob.value;

                await loadDuties(firstJob.value);

            }
            else {

                document.getElementById("dutiesList").innerHTML =
                    '<div class="empty-message">برای این رسته شغلی، شغلی ثبت نشده است</div>';
            }

        }
        catch (error) {

            console.error(error);

            document.getElementById("dutiesList").innerHTML =
                '<div class="empty-message">خطا در دریافت مشاغل</div>';
        }
    }


    // ==========================================
    // دریافت مشاغل یک رسته
    // ==========================================

    async function loadJobs(categoryId) {

        const response =
            await fetch(
                '@Url.Action("GetJobsByCategory", "Employees")?categoryId='
                + encodeURIComponent(categoryId)
            );

        if (!response.ok) {
            throw new Error("خطا در دریافت مشاغل");
        }

        const jobs = await response.json();

        const select =
            document.getElementById("jobSelect");

        select.innerHTML =
            '<option value="">انتخاب عنوان شغلی</option>';

        jobs.forEach(job => {

            const option = document.createElement("option");

            option.value = job.id;
            option.textContent = job.title;

            select.appendChild(option);
        });
    }


    // ==========================================
    // وقتی شغل تغییر می‌کند
    // ==========================================

    async function onJobChanged() {

        const jobId =
            document.getElementById("jobSelect").value;

        if (!jobId) {

            document.getElementById("dutiesList").innerHTML =
                '<div class="empty-message">ابتدا یک شغل را انتخاب کنید</div>';

            selectedDuty = null;

            return;
        }

        try {

            await loadDuties(jobId);

        }
        catch (error) {

            console.error(error);

            document.getElementById("dutiesList").innerHTML =
                '<div class="empty-message">خطا در دریافت شرح وظایف</div>';
        }
    }


    // ==========================================
    // دریافت شرح وظایف یک شغل
    // ==========================================

    async function loadDuties(jobId) {

        selectedDuty = null;

        const dutiesList =
            document.getElementById("dutiesList");

        dutiesList.innerHTML =
            '<div class="loading">در حال بارگذاری شرح وظایف...</div>';

        const response =
            await fetch(
                '@Url.Action("GetJobDuties", "Employees")?jobId='
                + encodeURIComponent(jobId)
            );

        if (!response.ok) {
            throw new Error("خطا در دریافت شرح وظایف");
        }

        const duties = await response.json();

        if (!duties || duties.length === 0) {

            dutiesList.innerHTML =
                '<div class="empty-message">برای این شغل شرح وظیفه‌ای ثبت نشده است</div>';

            return;
        }

        dutiesList.innerHTML = "";

        duties.forEach(duty => {

            const wrapper =
                document.createElement("label");

            wrapper.className = "duty-item";

            const radio =
                document.createElement("input");

            radio.type = "radio";
            radio.name = "selectedDuty";
            radio.value = duty.id;

            radio.addEventListener("change", function () {

                selectedDuty = duty;

            });

            const text =
                document.createElement("span");

            text.className = "duty-text";
            text.textContent = duty.description;

            wrapper.appendChild(radio);
            wrapper.appendChild(text);

            dutiesList.appendChild(wrapper);
        });
    }


    // ==========================================
    // انتخاب وظیفه و قرار دادن در ردیف
    // ==========================================

    function selectDuty() {

        if (!selectedDuty) {

            alert("لطفاً ابتدا یک شرح وظیفه را انتخاب کنید.");

            return;
        }

        if (currentResultRow === null) {
            return;
        }

        const taskInput =
            document.getElementById(
                "task_" + currentResultRow
            );

        if (taskInput) {

            taskInput.value =
                selectedDuty.description;
        }

        closeDutySelector();
    }


    // ==========================================
    // بستن پنجره
    // ==========================================

    function closeDutySelector() {

        document
            .getElementById("dutyModal")
            .classList.remove("show");

        currentResultRow = null;
        selectedDuty = null;
    }


    // ==========================================
    // کلیک روی پس‌زمینه مودال
    // ==========================================

    function handleModalBackgroundClick(event) {

        if (event.target.id === "dutyModal") {

            closeDutySelector();
        }
    }


    // ==========================================
    // ثبت ارزیابی
    // ==========================================

    function saveEvaluation() {

        alert("فرم ارزیابی آماده ثبت است.");
    }

</script>

</body>
</html>